[Unit]
Description=Warframe Profile web UI
Documentation=https://github.com/Regateiro/warframe-profile#readme
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@SERVICE_EXEC@
WorkingDirectory=@SERVICE_WORKDIR@
Restart=on-failure
RestartSec=5

# Web server options (see README: Web UI).
Environment=WARFRAME_WEB_HOST=127.0.0.1
Environment=WARFRAME_WEB_PORT=8090

# Lightweight sandboxing. The server only needs the network and access to
# the game process.
#
# Do NOT add mount-namespace hardening here (PrivateTmp, ProtectSystem,
# ProtectHome, PrivateMounts, ...).  In a rootless systemd user service those
# options put the unit in its own user namespace, and the kernel then denies
# reads of /proc/<warframe-pid>/maps and /proc/<warframe-pid>/mem across user
# namespaces.  The credential scanner needs both files, so the service would
# report "Could not find accountId/nonce in Warframe memory".
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
